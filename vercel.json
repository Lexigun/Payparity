{
  "version": 2,
  "routes": [
    { "src": "/", "dest": "/home.html" },
    { "src": "/salary-calculator", "dest": "/index.html" },
    { "src": "/freelance-rate", "dest": "/freelance-rate.html" },
    { "src": "/last-day", "dest": "/last-day.html" },
    { "src": "/llc-vs-sole", "dest": "/llc-vs-sole.html" },
    { "src": "/contract-scanner", "dest": "/contract-scanner.html" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/ads.txt", "dest": "/ads.txt" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
